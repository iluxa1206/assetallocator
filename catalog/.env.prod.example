# Production secrets for docker-compose.prod.yml — copy to .env.prod and fill in.
# .env.prod is gitignored. NEVER commit real secrets.

# Postgres password — strong random, NOT the dev default astra_dev
#   generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# FastAPI SECRET_KEY (JWT signing) — strong random
#   generate: openssl rand -hex 32
SECRET_KEY=

# Cloudflare Tunnel token — Zero Trust → Networks → Tunnels → your tunnel
TUNNEL_TOKEN=
