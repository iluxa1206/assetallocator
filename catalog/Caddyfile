# Caddy reverse proxy for assetallocator.ru (RF VPS).
# Auto-provisions Let's Encrypt TLS for the domains below (needs public ports 80+443
# and A-records pointing to the VPS IP). Proxies everything to the Next.js frontend,
# which itself rewrites /api/* → backend (same-origin, no CORS).

assetallocator.ru, www.assetallocator.ru {
	encode gzip
	reverse_proxy frontend:3000
}
